PORT=3001
# 可选：监听地址。生产建议 127.0.0.1（仅由同机反向代理访问）
# HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 推理强度（step-3.7-flash 等支持的模型）：low / medium / high，默认 low
# 请求体携带 reasoning_effort 可临时覆盖此默认值
LLM_REASONING_EFFORT=low

# ── AI 代理安全（详见 docs/ai-proxy-security.md）──
# 认证模式：
#   local-dev     非 production 默认值；只接受本机回环、且不带 X-Forwarded-*/Forwarded 头的请求（Vite 代理联调可用）
#   shared-secret 反向代理完成用户 session/登录校验后注入秘钥头；前端不持有秘钥
#   disabled      关闭 AI 调用
# NODE_ENV=production 且未设置 / 配置无效时，AI 调用一律 503（fail closed）
# AI_PROXY_AUTH_MODE=shared-secret
# AI_PROXY_SHARED_SECRET=<至少 32 字符随机串，例如 openssl rand -hex 32>
# AI_PROXY_SECRET_HEADER=x-ai-proxy-secret
# 可选：秘钥校验通过后才信任的用户标识头（用作限流 key），由反向代理设置并覆盖客户端同名头
# AI_PROXY_CLIENT_ID_HEADER=x-auth-request-user

# 模型白名单（逗号分隔，必须包含 LLM_MODEL；默认仅 LLM_MODEL）
# LLM_ALLOWED_MODELS=deepseek-chat

# 上游超时与重试（前端已重试 3 次，后端默认不重试）
# LLM_TIMEOUT_MS=70000
# LLM_MAX_RETRIES=0
# 单次输出 token 上限（同时是默认 max_tokens；客户端只能调低）
# LLM_MAX_OUTPUT_TOKENS=8192

# 请求预算
# AI_MAX_BODY_BYTES=524288
# AI_MAX_MESSAGES=40
# AI_MAX_MESSAGE_CHARS=60000
# AI_MAX_TOTAL_CHARS=100000

# 限流与并发（单进程内存计数）
# AI_RATE_LIMIT_PER_CLIENT_PER_MIN=40
# AI_RATE_LIMIT_GLOBAL_PER_MIN=120
# AI_MAX_CONCURRENT=12
# AI_MAX_QUEUE=24
# AI_QUEUE_TIMEOUT_MS=15000

# 健康检查：默认 /api/ai/health 不调用模型；开启后 /api/ai/health?probe=1 需认证且有冷却缓存
# AI_HEALTH_PROBE_ENABLED=false
# AI_HEALTH_PROBE_COOLDOWN_MS=300000
